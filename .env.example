# Copia a .env y completa. Nunca subas .env al repo.
# Las fases 1-3 (datos y backtest) no necesitan claves.

# Binance Testnet (testnet.binance.vision): dinero ficticio. Necesarias para el modo demo.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance real: NO las uses todavía. Solo para el modo live (con permisos de lectura y
# trading spot, SIN retiros y con restricción de IP).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Alertas por Telegram (opcional). 1) crea un bot con @BotFather y copia el token; 2) escríbele "hola";
# 3) ejecuta `python -m bot_eve.notify chat-id`; 4) pon aquí ambos valores y activa notify.telegram.enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard: necesario solo para el botón de parada de emergencia. Elige una clave larga y propia.
DASHBOARD_TOKEN=
