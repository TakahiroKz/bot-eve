# Copia a .env.local y ajusta. NUNCA subas .env.local al repositorio.

# Base de datos. Sin DATABASE_URL se usa Postgres embebido (PGlite) en .data/ (solo desarrollo).
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# Clave para firmar sesiones (mínimo 32 caracteres aleatorios).
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Panel de administración: URL propia (sin enlaces desde la tienda), contraseña y TOTP opcional.
ADMIN_PATH=/gestion-privada
# Genera el hash con:  npm run admin:hash -- "tu contraseña"
ADMIN_PASSWORD_HASH=
# Solo desarrollo (se ignora si hay ADMIN_PASSWORD_HASH):
# ADMIN_PASSWORD=admin
# Secreto TOTP en base32 (Google Authenticator, etc.). Vacío = sin segundo factor.
# ADMIN_TOTP_SECRET=

# Pagos: "simulated" solo en desarrollo; en producción usa el proveedor real cuando se defina.
PAYMENTS_PROVIDER=simulated
# URL pública de la tienda (para enlaces y sitemap).
SITE_URL=http://localhost:3000
